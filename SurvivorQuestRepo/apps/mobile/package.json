{
  "name": "mobile",
  "version": "1.1.2",
  "main": "index.ts",
  "scripts": {
    "dev": "cross-env EXPO_NO_DOCTOR=1 expo start",
    "start": "cross-env EXPO_NO_DOCTOR=1 expo start",
    "android": "cross-env EXPO_NO_DOCTOR=1 expo start --android",
    "ios": "cross-env EXPO_NO_DOCTOR=1 expo start --ios",
    "web": "cross-env EXPO_NO_DOCTOR=1 expo start --web",
    "build:apk": "npx eas-cli build --platform android --profile beta --wait",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --ci --runInBand",
    "test:smoke": "jest --ci --runInBand --testPathPattern=smoke",
    "build:smoke": "cross-env EXPO_NO_DOCTOR=1 expo export --platform web --output-dir .expo-test-bundle-ci --clear"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-location": "~57.0.15",
    "expo-navigation-bar": "~57.0.2",
    "expo-sensors": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@expo/dom-webview": "~57.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "^57.0.10",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
