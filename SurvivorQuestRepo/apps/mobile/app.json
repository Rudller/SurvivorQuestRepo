{
  "expo": {
    "name": "SurvivorQuest",
    "slug": "survivorquest",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.survivorquest.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aplikacja potrzebuje lokalizacji, aby pokazać pozycję drużyny na mapie realizacji.",
        "NSCameraUsageDescription": "Aplikacja potrzebuje kamery, aby skanować QR i wykonywać zdjęcia podczas realizacji."
      }
    },
    "android": {
      "package": "com.survivorquest.app",
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111419"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-sensors",
      "expo-asset",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Montserrat",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Montserrat_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Montserrat_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Montserrat_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "PlayfairDisplay",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PlayfairDisplay_400Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Montserrat_500Medium.ttf",
              "./assets/fonts/Montserrat_600SemiBold.ttf",
              "./assets/fonts/Montserrat_700Bold.ttf",
              "./assets/fonts/PlayfairDisplay_400Regular.ttf"
            ]
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#111419"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b645b543-8bdc-44ed-b0e4-35978516f56a"
      }
    }
  }
}
