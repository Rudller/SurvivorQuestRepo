generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
}

enum UserStatus {
  ACTIVE
  INVITED
  BLOCKED
}

enum StationType {
  QUIZ
  AUDIO_QUIZ
  TIME
  POINTS
  WORDLE
  HANGMAN
  MASTERMIND
  ANAGRAM
  CAESAR_CIPHER
  MEMORY
  SIMON
  REBUS
  BOGGLE
  MINI_SUDOKU
  MATCHING
  STRONG_PASSWORD
  PHOTO_TASK
  QR_HUNT
  OPEN_QUIZ
}

enum TeamPhotoKind {
  TEAM_SELFIE
  TASK_PROOF
}

enum RealizationStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum RealizationType {
  OUTDOOR_GAMES
  HOTEL_GAMES
  WORKSHOPS
  EVENING_ATTRACTIONS
  DJ
  RECREATION
  RISK_QUIZ
}

enum RiskDifficulty {
  EASY
  MEDIUM
  HARD
}

enum RealizationLanguage {
  POLISH
  ENGLISH
  UKRAINIAN
  RUSSIAN
  OTHER
}

enum TeamStatus {
  UNASSIGNED
  ACTIVE
  OFFLINE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum EventActorType {
  ADMIN
  MOBILE_DEVICE
  SYSTEM
}

enum PointsQrClaimMode {
  PER_TEAM
  FIRST_TEAM
}

model User {
  id           String        @id @default(uuid())
  displayName  String
  email        String        @unique
  phone        String?
  role         UserRole      @default(INSTRUCTOR)
  status       UserStatus    @default(INVITED)
  photoUrl     String?
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  authSessions AuthSession[]
  chatMessages ChatMessage[]
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Station {
  id               String             @id @default(uuid())
  name             String
  type             StationType
  categories       String[]           @default([])
  description      String
  imageUrl         String?
  points           Int
  timeLimitSeconds Int                @default(0)
  completionCode   String?
  qrEntryCode      String?
  qrScanCodes      String[]           @default([])
  quizData         Json?
  translations     Json?
  challengeDifficultyMode String             @default("admin")
  challengeDifficulty String                 @default("medium")
  completionStopwatchEnabled Boolean       @default(false)
  allowConcurrentTeams Boolean             @default(false)
  fastestCompletionBonusPoints Int         @default(0)
  color            String             @default("#f59e0b")
  latitude         Float?
  longitude        Float?
  sourceTemplateId String?
  scenarioInstanceId String?
  realizationId    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sourceTemplate   Station?           @relation("StationTemplate", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  derivedStations  Station[]          @relation("StationTemplate")
  scenarioStations ScenarioStation[]
  taskProgresses   TeamTaskProgress[]
  photos           TeamPhoto[]
  stationScans     TeamStationScan[]
  riskPoolMemberships RiskPoolStation[]
  riskAttempts     RiskAttempt[]
  riskPendingDraws RiskPendingDraw[]
  pendingStationLaunches PendingStationLaunch[]

  @@unique([realizationId, qrEntryCode])
}

model Scenario {
  id               String           @id @default(uuid())
  name             String
  description      String
  introText        String?
  gameRules        String?
  sourceTemplateId String?
  realizationId    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  sourceTemplate   Scenario?        @relation("ScenarioTemplate", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  derivedScenarios Scenario[]       @relation("ScenarioTemplate")
  scenarioStations ScenarioStation[]
  realizations     Realization[]
}

model ScenarioStation {
  id        String   @id @default(uuid())
  scenarioId String
  stationId String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scenario  Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, order])
  @@unique([scenarioId, stationId])
  @@index([stationId])
}

model Realization {
  id                  String             @id @default(uuid())
  companyName         String
  location            String?
  language            RealizationLanguage @default(POLISH)
  customLanguage      String?
  introText           String?
  gameRules           String?
  translations        Json?
  contactPerson       String
  contactPhone        String?
  contactEmail        String?
  instructors         Json?
  notes               String?
  type                RealizationType
  logoUrl             String?
  hideMap             Boolean            @default(false)
  mapImageUrl         String?
  offerPdfUrl         String?
  offerPdfName        String?
  scenarioId          String?
  teamCount           Int
  requiredDevicesCount Int
  peopleCount         Int
  positionsCount      Int
  durationMinutes     Int                @default(120)
  status              RealizationStatus
  scheduledAt         DateTime
  // Stamped every time the realization enters `in-progress`, i.e. when the
  // organiser actually presses start — unlike `scheduledAt`, which is the
  // planned slot. Drives the pre-game countdown the tablets show, so that
  // every device counts down to the same instant.
  startedAt           DateTime?
  locationRequired    Boolean            @default(true)
  showLeaderboard     Boolean            @default(true)
  showLeaderboardDuringGame Boolean      @default(true)
  showLeaderboardOnFinish Boolean        @default(true)
  hideLeaderboardMinutesBeforeEnd Int    @default(0)
  teamStationNumberingEnabled Boolean    @default(true)
  timedStationPointsDecayEnabled Boolean @default(false)
  hideTaskList        Boolean            @default(false)
  joinCode            String             @unique
  riskSchemeId        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  scenario            Scenario?          @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  riskScheme          RiskScheme?        @relation("RealizationChosenRiskScheme", fields: [riskSchemeId], references: [id], onDelete: SetNull)
  // Clones this realization owns (see RiskScheme/RiskCategory.realizationId). The
  // deck it actually plays is riskScheme above — normally one of these clones.
  ownedRiskSchemes    RiskScheme[]       @relation("RealizationOwnedRiskSchemes")
  ownedRiskCategories RiskCategory[]     @relation("RealizationOwnedRiskCategories")
  teams               Team[]
  teamAssignments     TeamAssignment[]
  teamTaskProgresses  TeamTaskProgress[]
  eventLogs           EventLog[]
  photos              TeamPhoto[]
  stationScans        TeamStationScan[]
  pointsQrCodes       PointsQrCode[]
  riskCards           RiskCard[]
  riskAttempts        RiskAttempt[]
}

model Team {
  id                 String             @id @default(uuid())
  realizationId      String
  slotNumber         Int
  name               String?
  color              String?
  badgeKey           String?
  badgeImageUrl      String?
  points             Int                @default(0)
  taskTotal          Int                @default(0)
  taskDone           Int                @default(0)
  status             TeamStatus         @default(UNASSIGNED)
  lastLocationLat    Float?
  lastLocationLng    Float?
  lastLocationAccuracy Float?
  lastLocationAt     DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  realization        Realization        @relation(fields: [realizationId], references: [id], onDelete: Cascade)
  assignments        TeamAssignment[]
  taskProgresses     TeamTaskProgress[]
  eventLogs          EventLog[]
  photos             TeamPhoto[]
  stationScans       TeamStationScan[]
  pointsQrClaims     PointsQrCodeClaim[]
  riskAttempts       RiskAttempt[]
  riskPendingDraw    RiskPendingDraw?
  pendingStationLaunch PendingStationLaunch?

  @@unique([realizationId, slotNumber])
  @@unique([realizationId, color])
  @@unique([realizationId, badgeKey])
}

model TeamAssignment {
  id          String     @id @default(uuid())
  realizationId String
  teamId      String
  deviceId    String
  memberName  String?
  sessionToken String    @unique
  expiresAt   DateTime
  lastSeenAt  DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  realization Realization @relation(fields: [realizationId], references: [id], onDelete: Cascade)
  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([realizationId, deviceId])
}

model TeamTaskProgress {
  id           String     @id @default(uuid())
  realizationId String
  teamId       String
  stationId    String
  status       TaskStatus @default(TODO)
  pointsAwarded Int       @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  realization  Realization @relation(fields: [realizationId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  station      Station    @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([realizationId, teamId, stationId])
  @@index([teamId])
  @@index([stationId])
}

// Latest admin command to open a regular-realization station on a team's
// tablet. The device consumes the row when polling; teamId is unique so a
// repeated click replaces an undelivered command instead of creating a queue.
model PendingStationLaunch {
  id        String   @id @default(uuid())
  teamId    String   @unique
  stationId String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId])
}

model TeamPhoto {
  id            String        @id @default(uuid())
  realizationId String
  teamId        String
  stationId     String?
  kind          TeamPhotoKind
  objectKey     String
  url           String
  createdAt     DateTime      @default(now())
  realization   Realization   @relation(fields: [realizationId], references: [id], onDelete: Cascade)
  team          Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  station       Station?      @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([realizationId, createdAt])
  @@index([teamId, kind])
  @@index([stationId])
}

model TeamStationScan {
  id            String      @id @default(uuid())
  realizationId String
  teamId        String
  stationId     String
  code          String
  scannedAt     DateTime    @default(now())
  realization   Realization @relation(fields: [realizationId], references: [id], onDelete: Cascade)
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  station       Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([realizationId, teamId, stationId, code])
  @@index([realizationId, teamId, stationId])
}

model PointsQrCode {
  id            String              @id @default(uuid())
  realizationId String
  code          String
  points        Int
  label         String?
  claimMode     PointsQrClaimMode   @default(PER_TEAM)
  createdAt     DateTime            @default(now())
  realization   Realization         @relation(fields: [realizationId], references: [id], onDelete: Cascade)
  claims        PointsQrCodeClaim[]

  @@unique([realizationId, code])
}

model PointsQrCodeClaim {
  id             String       @id @default(uuid())
  pointsQrCodeId String
  teamId         String
  realizationId  String
  claimedAt      DateTime     @default(now())
  pointsQrCode   PointsQrCode @relation(fields: [pointsQrCodeId], references: [id], onDelete: Cascade)
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([pointsQrCodeId, teamId])
  @@index([teamId])
}

// A named deck ("talia") assembled from existing, reusable Categories —
// same relationship shape as Scenario -> Station: the deck just assigns
// already-existing content, it doesn't own or clone it.
model RiskScheme {
  id               String              @id @default(uuid())
  // Unique only among templates (realizationId IS NULL) — enforced by a partial
  // index created in the migration, since Prisma's DSL can't express one. Clones
  // deliberately reuse their source's name.
  name             String
  // Set => this deck is a realization-owned clone, not a library template. Mirrors
  // Scenario/Station's realizationId + sourceTemplateId pair.
  realizationId    String?
  sourceTemplateId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  schemeCategories RiskSchemeCategory[]
  realizations     Realization[]       @relation("RealizationChosenRiskScheme")
  realization      Realization?        @relation("RealizationOwnedRiskSchemes", fields: [realizationId], references: [id], onDelete: Cascade)

  @@index([realizationId])
}

model RiskSchemeCategory {
  id         String       @id @default(uuid())
  schemeId   String
  categoryId String
  order      Int          @default(0)
  createdAt  DateTime     @default(now())
  scheme     RiskScheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  category   RiskCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([schemeId, categoryId])
  @@index([schemeId, order])
}

// A standalone, reusable pool of tasks (by difficulty) — a "task bank" for
// one topic, independent of any deck/realization, assignable into many
// decks — same standalone-library shape as Station templates.
model RiskCategory {
  id           String              @id @default(uuid())
  // Unique only among templates — see the RiskScheme.name note above.
  name         String
  // Base slug for this category's printed card codes (<codeSlug>-<difficulty>-<n>).
  // Set once (at creation, or lazily backfilled from the name in place on first
  // use) and never recomputed on rename, so renaming a category for display never
  // invalidates cards that are already printed and glued to physical decks.
  // A realization-owned clone COPIES its source's slug verbatim (and is therefore
  // only unique among templates, same partial index treatment as name) — that is
  // what keeps one printed QR sticker valid across every realization built from
  // the same template deck.
  codeSlug     String?
  // Set => realization-owned clone. See RiskScheme above.
  realizationId String?
  sourceTemplateId String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  poolStations RiskPoolStation[]
  cards        RiskCard[]
  schemes      RiskSchemeCategory[]
  realization  Realization?        @relation("RealizationOwnedRiskCategories", fields: [realizationId], references: [id], onDelete: Cascade)

  @@index([realizationId])
}

// Assigns an existing Station (any of the 19 library types — quiz, wordle,
// hangman, memory, ...) to a (category, difficulty) pool. Drawing a card
// picks a random un-attempted assignment from here instead of a bespoke
// question — the pool's content IS the shared Station library.
model RiskPoolStation {
  id         String         @id @default(uuid())
  categoryId String
  difficulty RiskDifficulty
  stationId  String
  createdAt  DateTime       @default(now())
  category   RiskCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  station    Station        @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([categoryId, difficulty, stationId])
  @@index([categoryId, difficulty])
}

model RiskCard {
  id            String         @id @default(uuid())
  realizationId String
  categoryId    String
  difficulty    RiskDifficulty
  code          String
  createdAt     DateTime       @default(now())
  realization   Realization    @relation(fields: [realizationId], references: [id], onDelete: Cascade)
  category      RiskCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attempts      RiskAttempt[]
  pendingDraws  RiskPendingDraw[]

  @@unique([realizationId, code])
  @@index([categoryId, difficulty])
}

model RiskAttempt {
  id            String         @id @default(uuid())
  realizationId String
  teamId        String
  cardId        String
  stationId     String
  selectedIndex Int?
  // null while a photo-task card waits for the Game Master's decision: the
  // station counts as attempted (it can't be drawn again) but nothing has been
  // scored yet. pointsDelta already holds the frozen award for that moment —
  // difficulty points times the streak multiplier the team had when it sent
  // the photo — and is applied to the team only once the decision lands.
  isCorrect     Boolean?
  pointsDelta   Int
  createdAt     DateTime       @default(now())
  realization   Realization    @relation(fields: [realizationId], references: [id], onDelete: Cascade)
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  card          RiskCard       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  station       Station        @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([teamId, stationId])
  @@index([realizationId, teamId])
}

// A draw ("losowanie") triggered remotely by an admin instead of a real
// physical QR scan — queued here until the team's device polls for it and
// consumes it (RiskQuizService.pollPendingDraw). teamId is unique: a team
// can only have one such draw in flight at a time, which doubles as the
// collision check on the admin trigger endpoint.
model RiskPendingDraw {
  id        String   @id @default(uuid())
  teamId    String   @unique
  cardId    String
  stationId String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  card      RiskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
}

model EventLog {
  id           String         @id @default(uuid())
  realizationId String
  teamId       String?
  actorType    EventActorType
  actorId      String
  eventType    String
  payload      Json
  createdAt    DateTime       @default(now())
  realization  Realization    @relation(fields: [realizationId], references: [id], onDelete: Cascade)
  team         Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([realizationId, createdAt])
  @@index([teamId, createdAt])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String?
  userName  String
  content   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
