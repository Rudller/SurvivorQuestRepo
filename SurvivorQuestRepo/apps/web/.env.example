# ---------------------------------------------------------------------------
# apps/web — publiczna strona
#
# Wszystkie zmienne są opcjonalne: bez nich aplikacja wstaje, ale po cichu traci
# funkcje. Kolumna „bez tego" mówi, co dokładnie się dzieje.
# ---------------------------------------------------------------------------

# Backend API base URL (bez końcówki /api — dokleja się sama)
# Dev: http://localhost:3001   Prod: https://survivorquest.pl
# Bez tego: galeria nie zweryfikuje kodu i nie pobierze zdjęć.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3001

# Kanoniczny adres serwisu — źródło canonical, Open Graph i sitemap.
# Bez tego: wszystko wskazuje na https://survivorquest.pl, także na stagingu.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analityka -------------------------------------------------------------

# Identyfikator GA4 (format G-XXXXXXX).
# Bez tego: analityka nie ładuje się nigdy, nawet po zgodzie użytkownika.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Token weryfikacyjny Google Search Console.
# Bez tego: brak meta weryfikacyjnej, domena nie potwierdzi właściciela.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Strona /download ------------------------------------------------------

# Bezpośredni link do najnowszego APK (np. artefakt z Expo).
# Bez tego: przycisk jest wyłączony i pokazuje „Wersja na Androida wkrótce”.
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=

# Link do App Store. Ma pierwszeństwo przed TestFlight.
# Bez obu: przycisk wyłączony, „Wersja na iOS wkrótce”.
NEXT_PUBLIC_IOS_APPSTORE_URL=
NEXT_PUBLIC_IOS_TESTFLIGHT_URL=

# --- Odnośniki i kontakt na landingu ---------------------------------------

# Panel admina. Bez tego: w dev http://localhost:3100/admin/login, w prod /admin/login.
NEXT_PUBLIC_ADMIN_URL=

# Cel przycisku „Zobacz demo aplikacji”. Bez tego: fallback z kodu.
NEXT_PUBLIC_DEMO_URL=

# Cel przycisku „Kontakt i wdrożenie”. Bez tego: fallback z kodu.
NEXT_PUBLIC_QUOTE_URL=

# Dane kontaktowe pokazywane na stronie i w stopce.
# Bez tego: kontakt@survivorquest.pl oraz +48 730 622 029.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
